{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sync-shared": "node ../scripts/sync-shared.mjs",
    "build:fixtures": "cross-env NEXT_PUBLIC_USE_FIXTURES=true next build",
    "dev:fixtures": "cross-env NEXT_PUBLIC_USE_FIXTURES=true next dev",
    "dev:demo": "cross-env NEXT_PUBLIC_DEMO_MODE=true NEXT_PUBLIC_USE_FIXTURES=true next dev --hostname 127.0.0.1",
    "build:demo": "cross-env NEXT_PUBLIC_DEMO_MODE=true NEXT_PUBLIC_USE_FIXTURES=true next build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.114.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remark": "^15.0.1",
    "remark-html": "^16.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
