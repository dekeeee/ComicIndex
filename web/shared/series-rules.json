{
  "volume_patterns": [
    "[\\s]*[（(]\\s*(\\d+)\\s*[)）]\\s*$",
    "[\\s]*第\\s*(\\d+)\\s*巻\\s*$",
    "[\\s]*(\\d+)\\s*巻\\s*$",
    "[\\s]*[Vv][Oo][Ll]\\.?\\s*(\\d+)\\s*$",
    "[\\s]+(\\d+)\\s*$"
  ],
  "strip_patterns": [
    "【[^】]*】",
    "\\[[^\\]]*\\]",
    "[（(]\\s*完\\s*[)）]",
    "[（(]\\s*(?:新装版|完全版|愛蔵版|文庫版|新版|特装版|限定版)\\s*[)）]",
    "\\s*(?:新装版|完全版|愛蔵版|文庫版|特装版|限定版)\\s*$"
  ],
  "normalize": {
    "fullwidth_to_halfwidth": true,
    "collapse_spaces": true,
    "trim": true,
    "lowercase_ascii": true
  }
}
